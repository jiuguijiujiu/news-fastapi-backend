.idea/
*.iml
*.iws
*.ipr

# VS Code
.vscode/

# Vim / Neovim
*.swp
*.swo
*~

# Sublime Text
*.sublime-project
*.sublime-workspace

# Eclipse
.project
.classpath
.settings/

# ==============================================
# Python 字节码与构建产物
# ==============================================
__pycache__/
*.py[cod]
*$py.class
*.so

# 打包与分发产物
build/
dist/
*.egg-info/
.eggs/
sdist/
wheels/
*.egg

# ==============================================
# 虚拟环境
# ==============================================
.venv/
venv/
env/
ENV/

# ==============================================
# 测试与代码质量工具缓存
# ==============================================
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# ==============================================
# 日志与临时文件
# ==============================================
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

*.tmp
*.bak
*.cache

# ==============================================
# 环境变量与本地敏感配置
# ==============================================
.env
.env.local
.env.*.local
# 示例配置文件需要纳入版本跟踪
!.env.example

# ==============================================
# Node.js / 前端构建产物（Vite + Vue）
# ==============================================
node_modules/
.vite/
*.local

# ==============================================
